{
    "name": "InterJIA · HyDeCoFfEE",
    // To build it locally instead, replace "image" with:
    //   "build": { "dockerfile": "Dockerfile", "context": ".." }
    "image": "geoocean/interjia:latest",
    // Clone BlueMath_tk into /workspaces and install it in editable mode
    "postCreateCommand": "bash .devcontainer/install_develop.sh",
    "hostRequirements": {
        "cpus": 4
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                "jupyter.notebookFileRoot": "${fileDirname}",
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    }
}